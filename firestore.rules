rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    function touchesProtectedFields(keys) {
      return keys.hasAny(['plan', 'stripeCustomerId', 'stripeSubscriptionId',
                           'stripeSubscriptionStatus', 'planRenewsAt']);
    }

    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && !touchesProtectedFields(request.resource.data.keys());
      allow update: if isOwner(uid)
                    && !touchesProtectedFields(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      match /wines/{id}        { allow read, write: if isOwner(uid); }
      match /wishes/{id}       { allow read, write: if isOwner(uid); }
      match /caves/{id}        { allow read, write: if isOwner(uid); }
      match /degustations/{id} { allow read, write: if isOwner(uid); }
      match /ventes/{id}       { allow read, write: if isOwner(uid); }
    }

    // Mapping Stripe customerId -> uid, écrit uniquement par les Cloud Functions (Admin SDK).
    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }

    // Deny-by-default : tout le reste est refusé explicitement.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
