# Copier en functions/.env.<project-id> (ex: functions/.env.cave-a-vin-4d110) et remplir.
# Ce fichier n'est PAS un secret : uniquement des identifiants publics (price IDs, URL).
# Les vraies clés secrètes (Stripe secret key, webhook secret, clé Gemini) se configurent via :
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set GEMINI_API_KEY

STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_yyy
APP_URL=https://nyakkkk.github.io/cave-a-vin/
